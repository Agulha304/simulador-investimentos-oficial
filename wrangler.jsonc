{
  // Publica o frontend (frontend/dist) no Cloudflare e encaminha /api/* para o backend.
  // O nome precisa ser IGUAL ao nome do Worker criado no painel do Cloudflare (o do seu projeto é wealthy-simulator).
  "name": "wealthy-simulator",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./frontend/dist",
    // rotas do React (/aulas/m1-l1, /ranking...) devolvem o index.html
    "not_found_handling": "single-page-application",
    // só /api/* passa pelo Worker; o resto é servido direto dos arquivos estáticos
    "run_worker_first": ["/api/*"]
  },
  // Backend FastAPI como Cloudflare Container (Dockerfile da raiz). Exige o plano Workers Paid.
  // Uma instância só: os workers em segundo plano (stop loss, proventos, renda fixa, snapshots) vivem dentro do app.
  "containers": [
    { "class_name": "Backend", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic" }
  ],
  "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "Backend" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
  // Mantém as variáveis definidas no painel (BACKEND_URL) quando o deploy roda pelo Git.
  "keep_vars": true
  // SEGREDOS (painel: Workers & Pages > wealthy-simulator > Settings > Variables and Secrets, tipo "Secret"):
  //   DATABASE_URL  (Supabase, Session pooler)  e  JWT_SECRET.
  // BACKEND_URL é opcional: se definida, o Worker usa esse backend externo em vez do container.
}
