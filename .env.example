# Copie para .env e ajuste.
DATABASE_URL=postgresql+psycopg://simulador@localhost:5433/simulador
TEST_DATABASE_URL=postgresql://postgres.kqvpqbdupafpbasrytqw:-Simulainvest2205@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Em produção use ENVIRONMENT=production: o app recusa subir com JWT_SECRET fraco ou banco em localhost.
ENVIRONMENT=development

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor
JWT_EXPIRE_MINUTES=720

# Saldo virtual inicial de cada nova carteira (BRL)
INITIAL_BALANCE=100000.00

# Liga/desliga os workers periódicos (APScheduler)
SCHEDULER_ENABLED=true

# Se mudar FRONTEND_PORT (scripts/dev.sh), ajuste aqui também.
CORS_ORIGINS=http://localhost:5173,https://wealthy-simulator.giuliapeluzzos.workers.dev
LOG_LEVEL=INFO

# Supabase (Connect > Session pooler, porta 5432). Nunca use o banco do Supabase como TEST_DATABASE_URL.
# DATABASE_URL=postgresql://postgres.<project-id>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
