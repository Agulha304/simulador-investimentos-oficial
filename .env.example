# Copie para .env e ajuste.
DATABASE_URL=postgresql+psycopg://simulador@localhost:5433/simulador
TEST_DATABASE_URL=postgresql+psycopg://simulador@localhost:5433/simulador_test

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor
JWT_EXPIRE_MINUTES=720

# Saldo virtual inicial de cada nova carteira (BRL)
INITIAL_BALANCE=100000.00

# Liga/desliga os workers periódicos (APScheduler)
SCHEDULER_ENABLED=true

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
